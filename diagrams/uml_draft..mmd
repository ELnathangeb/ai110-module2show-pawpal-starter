classDiagram

class Owner {
    +String name
    +int available_minutes
    +List preferences
    +List pets
    +add_pet(pet)
    +get_all_tasks()
}

class Pet {
    +String name
    +String species
    +int age
    +List tasks
    +add_task(task)
    +remove_task(task)
    +get_tasks()
}

class Task {
    +String name
    +int duration
    +String priority
    +String category
    +bool completed
    +mark_complete()
}

class Scheduler {
    +Owner owner
    +generate_daily_plan()
    +sort_tasks()
    +detect_conflicts()
}

Owner "1" --> "*" Pet
Pet "1" --> "*" Task
Scheduler --> Owner